#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                &kp ESC   &kp N1    &kp N2   &kp N3   &kp N4 &kp N5       &kp N6  &kp N7 &kp N8    &kp N9   &kp N0   &kp BSPC
                &kp TAB   &kp Q     &kp W    &kp E    &kp R  &kp T        &kp Y   &kp U  &kp I     &kp O    &kp P    &kp BSLH
                &kp LCTRL &kp A     &kp S    &kp D    &kp F  &kp G        &kp H   &kp J  &kp K     &kp L    &kp SEMI &kp SQT
                &kp LSHFT &kp Z     &kp X    &kp C    &kp V  &kp B        &kp N   &kp M  &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
                &kp GRAVE &kp LCTRL &kp LALT &kp LGUI &mo 1  &kp SPACE    &kp RET &mo 2  &kp LEFT  &kp DOWN &kp UP   &kp RIGHT
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
                &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6       &kp F7    &kp F8    &kp F9    &kp F10   &kp F11  &kp F12
                &trans    &trans    &trans    &trans    &trans    &trans       &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT  &trans   &trans
                &trans    &trans    &trans    &trans    &trans    &trans       &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &trans   &trans
                &trans    &trans    &trans    &trans    &trans    &trans       &kp HOME  &kp PG_DN &kp PG_UP &kp END   &trans   &trans
                &trans    &trans    &trans    &trans    &trans    &trans       &trans    &trans    &trans    &trans    &trans   &trans
            >;
        };

        system_layer {
            display-name = "System";
            bindings = <
                &bootloader  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4    &trans &trans &trans &trans &trans &bootloader
                &sys_reset   &trans       &trans       &trans       &trans       &bt BT_CLR      &trans &trans &trans &trans &trans &sys_reset
                &trans       &trans       &trans       &trans       &trans       &trans          &trans &trans &trans &trans &trans &trans
                &trans       &trans       &trans       &trans       &trans       &trans          &trans &trans &trans &trans &trans &trans
                &trans       &trans       &trans       &trans       &trans       &trans          &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};
