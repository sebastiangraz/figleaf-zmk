if BOARD_FIGLEAF_LEFT

config ZMK_KEYBOARD_NAME
    default "Figleaf"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif # BOARD_FIGLEAF_LEFT

if BOARD_FIGLEAF_LEFT || BOARD_FIGLEAF_RIGHT

config BOARD
    default "figleaf"

config ZMK_SPLIT
    default y

config BT_CTLR
    default BT

if USB

config USB_NRFX
    default y

config USB_DEVICE_STACK
    default y

endif # USB

config ZMK_BATTERY_NRF_VDDH
    default y

endif # BOARD_FIGLEAF_LEFT || BOARD_FIGLEAF_RIGHT
